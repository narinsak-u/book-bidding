# Local Book Bidding database for the development OIDC demo.
DATABASE_URL="file:local.db"

# Direct local dev origin and one-time OIDC confidential-client credentials.
PUBLIC_BASE_URL="http://localhost:5173"
PUBLIC_FRONTEND_URL="http://localhost:5173"
BETTER_AUTH_URL="http://localhost:5173"
CENTRAL_OIDC_ISSUER="http://localhost:8080/api/auth"
PUBLIC_CENTRAL_IDENTITY_URL="http://localhost:8080"
BIDDING_RECOVERY_OIDC_REDIRECT_URI="http://localhost:5173/api/identity-recovery/callback"
CENTRAL_OIDC_CLIENT_ID=
CENTRAL_OIDC_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Migration-only proof clients. Register only this callback with Google and GitHub:
# http://localhost:5173/api/identity-recovery/provider/callback
BIDDING_RECOVERY_GOOGLE_CLIENT_ID=
BIDDING_RECOVERY_GOOGLE_CLIENT_SECRET=
BIDDING_RECOVERY_GITHUB_CLIENT_ID=
BIDDING_RECOVERY_GITHUB_CLIENT_SECRET=

# Existing non-auth routes require these; use real project values to exercise those services.
PUBLIC_SUPABASE_URL="https://replace-with-your-project.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-project-key"
SECRET_STRIPE_KEY="sk_test_replace-with-project-key"
