# Local Book Bidding database for the OIDC demo.
DATABASE_URL="file:local.db"

# Local OIDC demo: copy the one-time confidential client credentials from the auth provisioning command.
PUBLIC_BASE_URL="https://bidding.127.0.0.1.sslip.io"
PUBLIC_FRONTEND_URL="https://bidding.127.0.0.1.sslip.io"
BETTER_AUTH_URL="https://bidding.127.0.0.1.sslip.io"
CENTRAL_OIDC_ISSUER="https://auth.127.0.0.1.nip.io/api/auth"
PUBLIC_CENTRAL_IDENTITY_URL="https://auth.127.0.0.1.nip.io"
CENTRAL_OIDC_CLIENT_ID=
CENTRAL_OIDC_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Existing non-auth routes require these; use real project values to exercise those services.
PUBLIC_SUPABASE_URL="https://replace-with-your-project.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-project-key"
SECRET_STRIPE_KEY="sk_test_replace-with-project-key"
